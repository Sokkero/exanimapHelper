<Window x:Class="ExanimapHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExanimapHelper" Height="640" Width="1024"
        MinHeight="480" MinWidth="800"
        Background="{StaticResource WindowBg}"
        Icon="/assets/appIcon.png">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: inputs, data list, controls -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">

            <!-- Bottom: Start/Stop + export buttons + status -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="StartStopButton" Content="Start (F8)" Height="32"
                        Click="StartStopButton_Click" />
                <Button x:Name="MarkPoiButton" Content="Mark POI (F10)" Height="28"
                        Margin="0,8,0,0" IsEnabled="False" Click="MarkPoiButton_Click" />
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedFg}" />
                <Button x:Name="ClearButton" Content="Clear" Height="28"
                        Margin="0,8,0,0" IsEnabled="False" Click="ClearButton_Click" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExportTextButton" Grid.Column="0"
                            Content="Export Data" Height="28" Margin="0,0,4,0"
                            IsEnabled="False" Click="ExportTextButton_Click" />
                    <Button x:Name="ImportTextButton" Grid.Column="1"
                            Content="Import Data" Height="28" Margin="4,0,0,0"
                            Click="ImportTextButton_Click" />
                </Grid>
                <Button x:Name="ExportPngButton" Content="Export PNG" Height="28"
                        Margin="0,8,0,0" IsEnabled="False" Click="ExportPngButton_Click" />
            </StackPanel>

            <!-- Top: address + interval inputs -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="X-Axis memory address:" />
                <TextBox x:Name="XAddressBox" Margin="0,2,0,10" Padding="4,3"
                         FontFamily="Consolas" LostFocus="Input_LostFocus" />

                <TextBlock Text="Y-Axis memory address:" />
                <TextBox x:Name="YAddressBox" Margin="0,2,0,10" Padding="4,3"
                         FontFamily="Consolas" LostFocus="Input_LostFocus" />

                <TextBlock Text="Poll interval (ms):" />
                <TextBox x:Name="IntervalBox" Text="500" Margin="0,2,0,10"
                         Padding="4,3" LostFocus="Input_LostFocus" />

                <!-- Live readout: current values being read, to verify the address -->
                <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="6"
                        Margin="0,0,0,10" Background="{StaticResource SurfaceBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Live X: " />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LiveXValue"
                                   Text="—" FontFamily="Consolas" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Live Y: " />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LiveYValue"
                                   Text="—" FontFamily="Consolas" />
                    </Grid>
                </Border>

                <TextBlock Text="Data:" Margin="0,0,0,2" />
            </StackPanel>

            <!-- Fill: scrollable data list -->
            <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                <ListBox x:Name="DataList" BorderThickness="0"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>
        </DockPanel>

        <!-- Right panel: graph canvas -->
        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <Canvas x:Name="GraphCanvas" Background="#FF1E1E1E" ClipToBounds="True" />
        </Border>
    </Grid>
</Window>
